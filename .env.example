# 后端环境变量示例。不含任何真实凭据。
# 需要时复制为 .env，仅保存在本机；.env 已在 .gitignore 中。
#
# 优先级：进程环境变量 > .env > configs/config.toml > 内置默认值。
# 前端不读取本文件。

# ---- 凭据（仅后端运行时读取，不写入日志/快照/前端）----
# 阶段级变量优先；缺失时回退到 AIDHU_API_KEY。
# S01 不调用模型，可以留空；S03 起必需。
AIDHU_API_KEY=
AIDHU_STAGE1_API_KEY=
AIDHU_STAGE2_API_KEY=

# ---- 配置文件位置（可选）----
# 默认依次查找 configs/config.toml、configs/config.local.toml。
# AIDHU_CONFIG_FILE=
# 默认由包位置推导；仅在非源码安装方式下需要显式指定。
# AIDHU_PROJECT_ROOT=

# ---- 模型与执行参数覆盖（可选，留空则使用 TOML/默认值）----
# AIDHU_STAGE1_BASE_URL=
# AIDHU_STAGE1_MODEL=
# AIDHU_STAGE1_TIMEOUT_SECONDS=
# AIDHU_STAGE2_BASE_URL=
# AIDHU_STAGE2_MODEL=
# AIDHU_STAGE2_TIMEOUT_SECONDS=
# AIDHU_CONCURRENCY=
# AIDHU_MAX_ATTEMPTS_PER_STAGE_CAMPAIGN=

# ---- 输入限制（可选）----
# AIDHU_MAX_UPLOAD_BYTES=
# AIDHU_MAX_RECORDS=

# ---- 路径覆盖（可选，相对路径按项目根解析）----
# AIDHU_DATABASE_PATH=
# AIDHU_UPLOADS_PATH=
# AIDHU_RUNTIME_PATH=
# AIDHU_OUTPUTS_PATH=
# AIDHU_LOGS_PATH=
# AIDHU_FRONTEND_DIST_PATH=
